# Secrets & local env
.env
.env.*
!.env.template

# Jekyll source + local Ruby/vendor trees (built HTML is what GitHub Pages serves)
academic-website-template/
vendor/
.bundle/
node_modules/
data/

# Old site backup — keep on disk, never push
backup_hyperspace_*/

# Build caches / intermediate output
.jekyll-cache/
.sass-cache/
_site/
**/_site/
.jekyll-metadata

# Maps / logs
*.css.map
*.log

# Accidental dependency dumps
assets/javascript/popper/

# OS / editor noise
.DS_Store
*.swp
*~

# Do NOT ignore:
# - *.html, assets/, images/, papers/cv.pdf  (site content for GitHub Pages)
# - verify-github-paths.sh, fix-web-perms.sh, install-git-hooks.sh, git-hooks/
#   (dual-host guards; academic-website-template/ is ignored so copies live at repo root)
