@article{gonzalezpicos2026betapic,
  author  = {González Picos, D. and Snellen, I. A. G. and Landman, R. and de Regt, S. and Grasser, N. and Birkby, J. L. and Stolker, T. and Koutalios, I. and Kenworthy, M. A.},
  title   = {The carbon isotope ratio of $\beta$ Pic b with high-resolution spectroscopy},
  journal = {Astronomy \& Astrophysics},
  year    = {2026},
  volume  = {711},
  pages   = {A87},
  doi     = {10.1051/0004-6361/202660276},
  eprint  = {2606.12401},
  archivePrefix = {arXiv},
  ads     = {2026A&A...711A..87G},
  adsurl  = {https://ui.adsabs.harvard.edu/abs/2026A&A...711A..87G},
  abstract = {Isotopic ratios trace the formation and evolution of planets and link their atmospheres to the chemistry of their natal protoplanetary discs. We measure 12C/13C = 58+18-15 in the atmosphere of the young super-Jupiter β Pic b from 11 nights of CRIRES+ K-band spectroscopy at the VLT.}
}

@article{gonzalezpicos2026hd19467,
  author  = {González Picos, D. and van der Post, T. and de Regt, S. and Ruffio, J.-B. and Grasser, N. and Snellen, I.},
  title   = {JWST high-contrast spectroscopy with speckle modelling: Atmospheric retrievals of the T-dwarf companion HD 19467 B},
  journal = {Astronomy \& Astrophysics},
  year    = {2026},
  volume  = {710},
  pages   = {A293},
  doi     = {10.1051/0004-6361/202659296},
  eprint  = {2605.02769},
  archivePrefix = {arXiv},
  ads     = {2026A&A...710A.293G},
  adsurl  = {https://ui.adsabs.harvard.edu/abs/2026A&A...710A.293G},
  abstract = {High-contrast, medium-resolution spectroscopy with JWST can resolve molecular and isotopic features in cool substellar atmospheres, but for close-in companions the extracted spectra can be biased by wavelength-dependent residual stellar contamination. We assess the impact of residual speckles on atmospheric inference for the T dwarf companion HD 19467 B.}
}

@article{gonzalezpicos2025natas,
  author  = {González Picos, D. and Snellen, I. and de Regt, S.},
  title   = {Chemical evolution imprints in the rare isotopes of nearby M dwarfs},
  journal = {Nature Astronomy},
  year    = {2025},
  volume  = {9},
  pages   = {1692},
  doi     = {10.1038/s41550-025-02641-4},
  eprint  = {2508.18424},
  archivePrefix = {arXiv},
  ads     = {2025NatAs...9.1692G},
  adsurl  = {https://ui.adsabs.harvard.edu/abs/2025NatAs...9.1692G},
  abstract = {We measure rare carbon and oxygen isotopes in 32 nearby M dwarfs spanning a range of metallicities using high-resolution infrared spectroscopy, finding that stars with higher metal content have lower 12C/13C ratios.}
}

@article{gonzalezpicos2025supjupiv,
  author  = {González Picos, D. and Snellen, I. A. G. and de Regt, S. and Landman, R. and Zhang, Y. and Gandhi, S. and Sánchez-López, A.},
  title   = {The ESO SupJup Survey IV: Unveiling the carbon isotope ratio of GQ Lup B and its host star},
  journal = {Astronomy \& Astrophysics},
  year    = {2025},
  volume  = {693},
  pages   = {A298},
  doi     = {10.1051/0004-6361/202451936},
  eprint  = {2501.01789},
  archivePrefix = {arXiv},
  ads     = {2025A&A...693A.298G},
  adsurl  = {https://ui.adsabs.harvard.edu/abs/2025A&A...693A.298G},
